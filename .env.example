# Copy to .env or .env.local and fill in real values.
# Never commit .env or .env.local.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rbt

# --- API / JWT (change JWT_SECRET_KEY in production) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Fernet key for encrypted EEO demographics (generate once, keep secret):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APPLICATION_DATA_ENCRYPTION_KEY=
API_BASE_URL=http://localhost:8000
# Public web app URL (email links, register CTA). Production: https://www.yarba.app
FRONTEND_URL=http://localhost:3000

# --- Portfolio deploy (Vercel; optional) ---
# Apex domain for generated sites at {subdomain}.yarba.app — not the same as FRONTEND_URL.
# VERCEL_DOMAIN_NAME=yarba.app
# VERCEL_AUTH_TOKEN=

# --- Firebase Admin (server-side; required for Firebase auth) ---
# Download service account JSON from Firebase Console, then either:
#   - set the variables below, or
#   - copy fields into .env (see config/firebase_credentials.json locally; gitignored)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
# Optional: base64-encoded private key instead of FIREBASE_PRIVATE_KEY
# FIREBASE_PRIVATE_KEY_BASE64=

# --- LLM providers (at least one if using AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- AWS / storage (optional; required for S3 uploads / portfolio deploy) ---
# Use either plain names (AWS_ACCESS_KEY) or STORAGE_-prefixed names below.
STORAGE_PROVIDER=aws_s3
STORAGE_AWS_ACCESS_KEY=
STORAGE_AWS_SECRET_KEY=
STORAGE_AWS_REGION=us-east-1
STORAGE_AWS_BUCKET=yarba-local
STORAGE_CLOUDFRONT_DISTRIBUTION_ID=

# --- Email-to-resume (Resend + ImprovMX forward resumes@yarba.app) ---
# Nested settings need double underscores. Use FEATURES (plural), not FEATURE.
# FEATURES__ENABLE_EMAIL_TO_RESUME=false
# RESEND__API_KEY=
# RESEND__WEBHOOK_SECRET=
# RESEND__FROM=resumes@yarba.app

# --- CORS (comma-separated or JSON list) ---
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
