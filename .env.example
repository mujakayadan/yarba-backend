# Copy to .env or .env.local and fill in real values.
# Never commit .env or .env.local.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rbt

# --- API / JWT (change JWT_SECRET_KEY in production) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_NATIVE_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
REFRESH_COOKIE_NAME=yarba_refresh
# REFRESH_COOKIE_DOMAIN=.yarba.app
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth/password
# Direct provider ID-token verification. Configure at least one audience for
# each enabled provider; comma-separate multiple first-party client IDs.
OAUTH_GOOGLE_WEB_AUDIENCES=
OAUTH_GOOGLE_IOS_AUDIENCES=
OAUTH_GOOGLE_ANDROID_AUDIENCES=
OAUTH_APPLE_AUDIENCES=
OAUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OAUTH_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
OAUTH_GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com
OAUTH_APPLE_ISSUER=https://appleid.apple.com
OAUTH_JWKS_CACHE_TTL_SECONDS=3600
# OAuth nonce is returned raw to the client once and separately bound to this
# signed, HttpOnly host-only cookie. Apple receives SHA-256(raw nonce) as
# lowercase hexadecimal; Google receives the raw nonce.
OAUTH_NONCE_COOKIE_NAME=yarba_oauth_nonce
OAUTH_NONCE_COOKIE_SECURE=true
OAUTH_NONCE_COOKIE_SAMESITE=lax
OAUTH_NONCE_COOKIE_PATH=/api/v1/auth/oauth
OAUTH_NONCE_COOKIE_MAX_AGE_SECONDS=600
# Provider client secrets are not used for ID-token verification.
# Firebase remains authoritative until native auth is explicitly enabled.
FEATURES__ENABLE_FIREBASE_AUTH=true
FEATURES__ENABLE_NATIVE_AUTH=false
# Fernet key for encrypted EEO demographics (generate once, keep secret):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APPLICATION_DATA_ENCRYPTION_KEY=
API_BASE_URL=http://localhost:8000
# Production (DigitalOcean): https://api.yarba.app — no trailing slash.
# Used for email links and the portfolio chatbot URL baked into deployed static sites.
# Public web app URL (email links, register CTA). Production: https://www.yarba.app
FRONTEND_URL=http://localhost:3000

# --- Portfolio deploy (Vercel; optional) ---
# Apex domain for generated sites at {subdomain}.yarba.app — not the same as FRONTEND_URL.
# VERCEL_DOMAIN_NAME=yarba.app
# VERCEL_AUTH_TOKEN=

# --- Firebase Admin (server-side; required for Firebase auth) ---
# Download service account JSON from Firebase Console, then either:
#   - set the variables below, or
#   - copy fields into .env (see config/firebase_credentials.json locally; gitignored)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
# Optional: base64-encoded private key instead of FIREBASE_PRIVATE_KEY
# FIREBASE_PRIVATE_KEY_BASE64=

# --- LLM providers (at least one if using AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- AWS / storage (optional; required for S3 uploads / portfolio deploy) ---
# Use either plain names (AWS_ACCESS_KEY) or STORAGE_-prefixed names below.
STORAGE_PROVIDER=aws_s3
STORAGE_AWS_ACCESS_KEY=
STORAGE_AWS_SECRET_KEY=
STORAGE_AWS_REGION=us-east-1
STORAGE_AWS_BUCKET=yarba-local
STORAGE_CLOUDFRONT_DISTRIBUTION_ID=

# --- Email-to-resume (Resend + ImprovMX forward resumes@yarba.app) ---
# Nested settings need double underscores. Use FEATURES (plural), not FEATURE.
# FEATURES__ENABLE_EMAIL_TO_RESUME=false
# RESEND__API_KEY=
# RESEND__WEBHOOK_SECRET=
# RESEND__FROM=noreply@yarba.app
# RESEND__RESUME_FROM=resumes@yarba.app

# --- CORS (comma-separated or JSON list) ---
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
