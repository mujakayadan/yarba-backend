# Copy to .env or .env.local and fill in real values.
# Never commit .env or .env.local.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rbt

# --- API / JWT (change JWT_SECRET_KEY in production) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Firebase Admin (server-side; required for Firebase auth) ---
# Download service account JSON from Firebase Console, then either:
#   - set the variables below, or
#   - copy fields into .env (see config/firebase_credentials.json locally; gitignored)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
# Optional: base64-encoded private key instead of FIREBASE_PRIVATE_KEY
# FIREBASE_PRIVATE_KEY_BASE64=

# --- LLM providers (at least one if using AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- AWS / storage (optional; required for S3 uploads / portfolio deploy) ---
# Bucket can be set as AWS_BUCKET or STORAGE_AWS_BUCKET depending on layout
STORAGE_PROVIDER=aws_s3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=yarba-local
CLOUDFRONT_DISTRIBUTION_ID=

# --- Email-to-resume (Resend + ImprovMX forward resumes@yarba.app) ---
# Nested settings need double underscores. Use FEATURES (plural), not FEATURE.
# FEATURES__ENABLE_EMAIL_TO_RESUME=false
# RESEND__API_KEY=
# RESEND__WEBHOOK_SECRET=
# RESEND__FROM=resumes@yarba.app

# --- CORS (comma-separated or JSON list) ---
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501
